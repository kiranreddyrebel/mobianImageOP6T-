[Unit]
Description=Call audio idle suspend workaround
After=dbus.service

[Service]
Type=simple
User=mobian
Group=mobian
Environment=HOME=/home/mobian
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/bin/sh /sbin/call_audio_idle_suspend_workaround.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=0
KillMode=control-group

[Install]
WantedBy=multi-user.target
